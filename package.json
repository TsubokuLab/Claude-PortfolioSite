{
  "name": "claude-portfoliosite",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:github": "vite build --base=/Claude-PortfolioSite/",
    "build:custom": "vite build --base=/",
    "lint": "eslint . --report-unused-disable-directives",
    "preview": "vite preview",
    "deploy": "npm run deploy:github",
    "deploy:github": "npm run build:github && gh-pages -d dist --dotfiles",
    "deploy:custom": "npm run build:custom"
  },
  "dependencies": {
    "framer-motion": "^11.0.5",
    "gsap": "^3.12.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.1",
    "three": "^0.161.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@eslint/js": "^9.18.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^9.18.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "gh-pages": "^6.1.1",
    "vite": "^5.1.0"
  }
}
